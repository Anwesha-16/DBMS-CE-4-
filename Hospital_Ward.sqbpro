ndex="3" value="124"/><column index="4" value="54"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">
-- Enable foreign key constraints
PRAGMA foreign_keys = ON;

-- 1. PATIENTS TABLE
CREATE TABLE IF NOT EXISTS patients (
    patient_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL COLLATE NOCASE UNIQUE,
    emergency_contact TEXT NOT NULL
);

-- 2. ADMISSIONS TABLE
CREATE TABLE IF NOT EXISTS admissions (
    admission_id INTEGER PRIMARY KEY AUTOINCREMENT,
    patient_id INTEGER NOT NULL,
    room_number TEXT NOT NULL,
    admission_date TEXT NOT NULL,

    FOREIGN KEY (patient_id)
    REFERENCES patients(patient_id)
    ON DELETE CASCADE
);

-- 3. TREATMENTS TABLE
CREATE TABLE IF NOT EXISTS treatments (
    treatment_id INTEGER PRIMARY KEY AUTOINCREMENT,
    admission_id INTEGER NOT NULL,
    procedure_name TEXT NOT NULL,
    cost REAL NOT NULL CHECK(cost &gt;= 0),

    FOREIGN KEY (admission_id)
    REFERENCES admissions(admission_id)
    ON DELETE CASCADE
);
</sql><sql name="SQL 2*">-- Insert Patients
INSERT INTO patients (name, emergency_contact)
VALUES
('Rahul Sharma', '9876543210'),
('Priya Verma', '9876543211'),
('Amit Kumar', '9876543212'),
('Sneha Gupta', '9876543213'),
('Arjun Singh', '9876543214');

-- Insert Admissions
INSERT INTO admissions (patient_id, room_number, admission_date)
VALUES
(1, '101', '2026-11-01'),
(2, '102', '2026-11-02'),
(3, '103', '2026-11-03'),
(1, '104', '2026-11-04'),
(4, '105', '2026-11-04'),
(5, '106', '2026-11-04');

-- Insert Treatments
INSERT INTO treatments (admission_id, procedure_name, cost)
VALUES
(1, 'Blood Test', 500),
(1, 'X-Ray', 1200),
(2, 'ECG', 800),
(3, 'General Checkup', 1000),
(4, 'MRI Scan', 3500),
(4, 'Blood Test', 500),
(5, 'Ultrasound', 1800),
(6, 'CT Scan', 4000);</sql><sql name="SQL 3*">-- Display Patients
SELECT * FROM patients;

-- Display Admissions
SELECT * FROM admissions;

-- Display Treatments
SELECT * FROM treatments;

-- Display Combined Hospital Ward Manifest
SELECT
    p.patient_id,
    p.name AS patient_name,
    p.emergency_contact,
    a.admission_id,
    a.room_number,
    a.admission_date,
    t.treatment_id,
    t.procedure_name,
    t.cost
FROM patients p
INNER JOIN admissions a
    ON p.patient_id = a.patient_id
INNER JOIN treatments t
    ON a.admission_id = t.admission_id
ORDER BY a.admission_id;</sql><sql name="SQL 4*">PRAGMA foreign_keys = ON;

-- Delete patient Rahul Sharma
DELETE FROM patients
WHERE patient_id = 1;

-- Check remaining patients
SELECT * FROM patients;

-- Check remaining admissions
SELECT * FROM admissions;

-- Check remaining treatments
SELECT * FROM treatments;

ROLLBACK;</sql><sql name="SQL 5*">-- SQL 5: Cost Validation

-- Insert a valid treatment cost
INSERT INTO treatments
(admission_id, procedure_name, cost)
VALUES
(1, 'Routine Checkup', 750);

-- Display the inserted record
SELECT *
FROM treatments
WHERE procedure_name = 'Routine Checkup';

-- Test negative treatment cost
INSERT INTO treatments
(admission_id, procedure_name, cost)
VALUES
(1, 'Invalid Procedure', -500);</sql><current_tab id="4"/></tab_sql></sqlb_project>
